msgid ""
msgstr ""
"Project-Id-Version: Ecomiq for WooCommerce 1.0.0\n"
"Language: es_ES\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"
"X-Domain: ecomiq-for-woocommerce\n"

msgid "Connect your store to Ecomiq in one click to sync products, stock, prices and orders."
msgstr "Conecta tu tienda con Ecomiq en un clic para sincronizar productos, stock, precios y pedidos."

msgid "Use an address like https://admin.ecomiq.pe, without a path."
msgstr "Usa una dirección como https://admin.ecomiq.pe, sin ruta."

msgid "WooCommerce could not create the API key."
msgstr "WooCommerce no pudo crear la clave de API."

msgid "The authorization code is invalid or expired. Connect again from Ecomiq."
msgstr "El código de autorización no es válido o venció. Vuelve a conectar desde Ecomiq."

msgid "WordPress does not detect HTTPS, so WooCommerce will reject the API key."
msgstr "WordPress no detecta HTTPS, así que WooCommerce rechazará la clave de API."

msgid "Settings"
msgstr "Ajustes"

msgid "You are not allowed to connect this store."
msgstr "No tienes permiso para conectar esta tienda."

msgid "Connect %s to Ecomiq"
msgstr "Conectar %s con Ecomiq"

msgid "Ecomiq will be able to read and update products, stock, prices and orders."
msgstr "Ecomiq podrá leer y actualizar productos, stock, precios y pedidos."

msgid "Ecomiq store"
msgstr "Tienda en Ecomiq"

msgid "Access as"
msgstr "Acceso como"

msgid "Returns to"
msgstr "Vuelve a"

msgid "This replaces the current connection."
msgstr "Reemplaza la conexión actual."

msgid "This replaces the current connection with %s."
msgstr "Reemplaza la conexión actual con %s."

msgid "Approve"
msgstr "Aprobar"

msgid "Cancel"
msgstr "Cancelar"

msgid "The link is incomplete or expired. Start again from Ecomiq."
msgstr "El enlace está incompleto o venció. Vuelve a empezar desde Ecomiq."

msgid "This request wants to return to %1$s, but this store only trusts %2$s. Do not approve it."
msgstr "Esta solicitud quiere volver a %1$s, pero esta tienda solo confía en %2$s. No la apruebes."

msgid "If you are testing your own Ecomiq installation, change the address under Advanced."
msgstr "Si pruebas tu propia instalación de Ecomiq, cambia la dirección en Avanzado."

msgid "Invalid request"
msgstr "Solicitud no válida"

msgid "Back"
msgstr "Volver"

msgid "Connect to Ecomiq"
msgstr "Conectar con Ecomiq"

msgid "Sync products, stock, prices and orders of %s with Ecomiq."
msgstr "Sincroniza productos, stock, precios y pedidos de %s con Ecomiq."

msgid "WordPress does not detect HTTPS. WooCommerce rejects API keys without it."
msgstr "WordPress no detecta HTTPS. WooCommerce rechaza las claves de API sin HTTPS."

msgid "Turn on permalinks in Settings → Permalinks."
msgstr "Activa los enlaces permanentes en Ajustes → Enlaces permanentes."

msgid "Connect"
msgstr "Conectar"

msgid "Advanced"
msgstr "Avanzado"

msgid "Ecomiq address"
msgstr "Dirección de Ecomiq"

msgid "Save"
msgstr "Guardar"

msgid "Change it only to test your own Ecomiq installation."
msgstr "Cámbiala solo para probar tu propia instalación de Ecomiq."

msgid "Connected to Ecomiq"
msgstr "Conectada con Ecomiq"

msgid "Ecomiq syncs products, stock, prices and orders of %s."
msgstr "Ecomiq sincroniza productos, stock, precios y pedidos de %s."

msgid "Not yet"
msgstr "Todavía no"

msgid "%s ago"
msgstr "hace %s"

msgid "Last access"
msgstr "Último acceso"

msgid "API key"
msgstr "Clave de API"

msgid "%1$s by %2$s"
msgstr "%1$s por %2$s"

msgid "Connected on"
msgstr "Conectada el"

msgid "Open Ecomiq"
msgstr "Abrir Ecomiq"

msgid "Disconnect"
msgstr "Desconectar"

msgid "Disconnect from Ecomiq?"
msgstr "¿Desconectar de Ecomiq?"

msgid "Ecomiq stops syncing this store. Its API key and webhooks are deleted. Your products and orders do not change."
msgstr "Ecomiq deja de sincronizar esta tienda. Se borran su clave de API y sus webhooks. Tus productos y pedidos no cambian."

msgid "Disconnected from Ecomiq."
msgstr "Desconectada de Ecomiq."

msgid "Address saved."
msgstr "Dirección guardada."

msgid "Disconnected from Ecomiq"
msgstr "Desconectada de Ecomiq"

msgid "Created a product"
msgstr "Creó un producto"

msgid "Updated a product"
msgstr "Actualizó un producto"

msgid "Updated stock"
msgstr "Actualizó el stock"

msgid "Updated a price"
msgstr "Actualizó un precio"

msgid "Changed a product status"
msgstr "Cambió el estado de un producto"

msgid "Deleted a product"
msgstr "Borró un producto"

msgid "Updated products in bulk"
msgstr "Actualizó productos en lote"

msgid "Created an order"
msgstr "Creó un pedido"

msgid "Updated an order"
msgstr "Actualizó un pedido"

msgid "Registered a webhook"
msgstr "Registró un webhook"

msgid "Removed a webhook"
msgstr "Quitó un webhook"

msgid "Changed store data"
msgstr "Cambió datos de la tienda"

msgid "A request failed"
msgstr "Falló una solicitud"

msgid "A webhook did not reach Ecomiq"
msgstr "Un webhook no llegó a Ecomiq"

msgid "Products: %d"
msgstr "Productos: %d"

msgid "Activity"
msgstr "Actividad"

msgid "Full logs"
msgstr "Registros completos"

msgid "Connect your store to Ecomiq to sync products, stock, prices and orders."
msgstr "Conecta tu tienda con Ecomiq para sincronizar productos, stock, precios y pedidos."

msgid "Dismiss this notice."
msgstr "Descartar este aviso."

msgid "When you connect this store, Ecomiq receives a WooCommerce API key and reads and updates products, stock, prices and orders, including the name, email, phone and addresses of the customer on each order. Ecomiq handles this data under its privacy policy: %s"
msgstr "Al conectar esta tienda, Ecomiq recibe una clave de API de WooCommerce y lee y actualiza productos, stock, precios y pedidos, incluidos el nombre, el correo, el teléfono y las direcciones del cliente de cada pedido. Ecomiq trata estos datos según su política de privacidad: %s"

msgid "%1$s answered instead of the REST API (HTTP %2$d). Ecomiq will be blocked the same way."
msgstr "%1$s respondió en lugar de la API REST (HTTP %2$d). A Ecomiq lo bloqueará igual."

msgid "A firewall"
msgstr "Un firewall"

msgid "Check again"
msgstr "Volver a probar"

msgid "Connection to Ecomiq"
msgstr "Conexión con Ecomiq"

msgid "Diagnostics"
msgstr "Diagnóstico"

msgid "Ecomiq access"
msgstr "Acceso de Ecomiq"

msgid "Ecomiq connects from:"
msgstr "Ecomiq se conecta desde:"

msgid "Ecomiq has not reached the store for %s. If a firewall protects the store, allow Ecomiq."
msgstr "Ecomiq no entra a la tienda desde hace %s. Si un firewall protege la tienda, permite a Ecomiq."

msgid "HTTPS"
msgstr "HTTPS"

msgid "If it blocks Ecomiq, allow its IP addresses in %s."
msgstr "Si bloquea a Ecomiq, permite sus IP en %s."

msgid "Permalinks"
msgstr "Enlaces permanentes"

msgid "REST API"
msgstr "API REST"

msgid "The REST API answered HTTP %d. A security plugin or the host may be restricting it."
msgstr "La API REST respondió HTTP %d. Un plugin de seguridad o el hosting puede estar restringiéndola."

msgid "This server cannot reach %1$s (%2$s). Changes in the store will not reach Ecomiq until the host allows it."
msgstr "Este servidor no llega a %1$s (%2$s). Los cambios de la tienda no llegarán a Ecomiq hasta que el hosting lo permita."

msgid "This server could not call itself, so the REST API was not tested. Some hosts block that test."
msgstr "Este servidor no pudo llamarse a sí mismo y la API REST no se probó. Algunos hostings bloquean esa prueba."

msgid "Webhooks"
msgstr "Webhooks"

msgid "Webhooks that did not reach Ecomiq in the last 24 hours: %d."
msgstr "Webhooks que no llegaron a Ecomiq en las últimas 24 horas: %d."

msgid "Ecomiq has not registered its webhooks yet, so it only sees changes on its scheduled checks."
msgstr "Ecomiq todavía no registró sus webhooks; solo ve los cambios en sus revisiones programadas."

msgid "Ecomiq webhooks paused or disabled: %d. WooCommerce disables a webhook after 5 failed deliveries in a row. Turn them back on in WooCommerce → Settings → Advanced → Webhooks."
msgstr "Webhooks de Ecomiq pausados o desactivados: %d. WooCommerce desactiva un webhook tras 5 entregas fallidas seguidas. Vuelve a activarlos en WooCommerce → Ajustes → Avanzado → Webhooks."

msgid "WooCommerce disabled an Ecomiq webhook after repeated failures"
msgstr "WooCommerce desactivó un webhook de Ecomiq tras varias fallas"

msgid "Turned an Ecomiq webhook back on"
msgstr "Volvió a activar un webhook de Ecomiq"

msgid "Ecomiq"
msgstr "Ecomiq"

msgid "Marks the orders that Ecomiq creates for sales on other channels. It never shows at checkout and charges nothing."
msgstr "Identifica los pedidos que Ecomiq crea por ventas en otros canales. Nunca aparece al pagar y no cobra nada."

msgid "Sold on another channel"
msgstr "Vendido en otro canal"

msgid "Shipping of the orders that Ecomiq creates for sales on other channels. It never shows at checkout."
msgstr "Envío de los pedidos que Ecomiq crea por ventas en otros canales. Nunca aparece al pagar."

msgid "Shipped by another channel"
msgstr "Enviado por otro canal"

msgid "Ecomiq created this order for a sale on another channel."
msgstr "Ecomiq creó este pedido por una venta en otro canal."

msgid "Sold on %s. Ecomiq created this order."
msgstr "Vendido en %s. Ecomiq creó este pedido."

msgid "Sold on %1$s, order %2$s. Ecomiq created this order."
msgstr "Vendido en %1$s, pedido %2$s. Ecomiq creó este pedido."
